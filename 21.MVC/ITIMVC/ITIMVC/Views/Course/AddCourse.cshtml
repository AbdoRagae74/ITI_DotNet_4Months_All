@model CourseDataandallDept
@{
    ViewData["Title"] = "Add New Instructor";
    SelectList alldepts = new SelectList(Model.Departments, "Id", "Name");
}
<h1>Add New Instructor</h1>
<section>


    <form method="post" asp-action="SaveAdd" asp-controller="Course" >
        <div class="my-2">
            <label asp-for="Name" ></label>
            <input class="form-control" asp-for="Name" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>

        <div class="my-2">
            <label asp-for="Degree"></label>
            <input class="form-control" asp-for="Degree" min="0" />
            <span asp-validation-for="Degree" class="text-danger"></span>

        </div>

        <div class="my-2">
            <label asp-for="MinDegree"></label>
            <input class="form-control" asp-for="MinDegree" min="0" />
            <span asp-validation-for="MinDegree" class="text-danger"></span>
        </div>

        <div class="my-2">
            <label asp-for="Hours"></label>
            <input class="form-control" asp-for="Hours" value="1" min="1" />
            <span asp-validation-for="Hours" class="text-danger"></span>

        </div>

        <div class="my-2">
            <label asp-for="deptID"></label>
           <select
            class="form form-control"
            asp-items="@alldepts"
            asp-for="deptID"            
           >

           </select>
        </div>
        <input type="submit" class="btn btn-success" />
    </form>
</section>

<a href="/Course/Index" class="btn btn-success my-2">Back to list</a>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
<script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
