@model TraineeCrsDegreeViewModel

<div class="container mt-3">
    <div class="card" style="width:400px;background-color:@Model.Color">
        <img class="card-img-top" src="/images/ins1.jpg" alt="Card image" style="width:100%">
        <div class="card-body">
            <h4 class="card-title">Name : @Model.TraineeName</h4>
            <h6 class="card-text">Course : @Model.CrsName</h6>
            <h6 class="card-text">Degree : @Model.CrsDegree</h6>
            <h6 class="card-text">Status : @Model.status</h6>
            

        </div>
    </div>

</div>



